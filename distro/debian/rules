#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_PLUGIN=ON -DINSTALL_SCRIPT=ON -DPACKAGE_SCRIPT=OFF -DCMAKE_EXPORT_COMPILE_COMMANDS=OFF -DMINIMIZE2TRAY_VERSION:STRING=$(DEB_VERSION_UPSTREAM) -DKDE_INSTALL_QMLDIR:PATH=lib/$(DEB_HOST_MULTIARCH)/qt6/qml -DKDE_INSTALL_PLUGINDIR:PATH=lib/$(DEB_HOST_MULTIARCH)/qt6/plugins

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp
